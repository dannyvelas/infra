#cloud-config
# Rendered by main.tf via templatefile() into vultr_instance.user_data.
# Runs unattended at first boot: creates the admin account, installs the
# update packages, and brings up SSH on ssh_port. The verify -> lock-down
# gate that disables root/password login stays external, in scripts/.
#
# IMPORTANT: ${...} below is Terraform templatefile() interpolation of values
# this file is rendered with. Shell variables created in runcmd (e.g.
# RECOVERY_PASSWORD) are deliberately referenced WITHOUT braces ($VAR, not
# ${VAR}) to avoid colliding with Terraform's template syntax.

package_update: true
packages:
  - unattended-upgrades
  - apt-listchanges
  - bsd-mailx

users:
  - name: ${admin_username}
    groups: [sudo]
    shell: /bin/bash
    # Passwordless sudo — exactly "ALL=(ALL) NOPASSWD:ALL".
    sudo: ["ALL=(ALL) NOPASSWD:ALL"]
    ssh_authorized_keys:
      - ${admin_public_key}

runcmd:
  - set -e
  # The console-recovery password is generated on this instance and is
  # never templated into this file, so it never enters user_data or
  # Terraform state. scripts/fetch-recovery-password.sh retrieves and
  # deletes /root/.console-recovery-password exactly once, later.
  - RECOVERY_PASSWORD=$(openssl rand -base64 18)
  - printf '%s:%s\n' "${admin_username}" "$RECOVERY_PASSWORD" | chpasswd
  - install -m 600 -o root -g root /dev/null /root/.console-recovery-password
  - printf '%s\n' "$RECOVERY_PASSWORD" > /root/.console-recovery-password
  - printf 'Port %s\n' "${ssh_port}" > /etc/ssh/sshd_config.d/00-admin.conf
  - systemctl is-active ssh.socket && systemctl restart ssh.socket || systemctl restart ssh
  - |
    cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
    APT::Periodic::Update-Package-Lists "1";
    APT::Periodic::Unattended-Upgrade "1";
    EOF
  - printf 'Unattended-Upgrade::Mail "%s";\n' "${update_notification_email}" > /etc/apt/apt.conf.d/51custom-unattended-upgrades
  - printf 'Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";\n' >> /etc/apt/apt.conf.d/51custom-unattended-upgrades
  - printf 'Unattended-Upgrade::Remove-Unused-Dependencies "true";\n' >> /etc/apt/apt.conf.d/51custom-unattended-upgrades
  - printf 'Unattended-Upgrade::Automatic-Reboot "true";\n' >> /etc/apt/apt.conf.d/51custom-unattended-upgrades
  - printf 'Unattended-Upgrade::Automatic-Reboot-Time "%s";\n' "${update_reboot_time}" >> /etc/apt/apt.conf.d/51custom-unattended-upgrades
  - systemctl enable --now unattended-upgrades
